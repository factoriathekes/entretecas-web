---
// Testimonio: cita literal y autoría. Las comillas «» las pone el componente (abre en el primer párrafo,
// cierra en el último). Un texto corto (extracto) va grande; uno de varios párrafos (testimonio completo
// de /casos/), a tamaño de lectura.
interface Props {
  texto: string | string[];
  autoria: string;
}

const { texto, autoria } = Astro.props;
const parrafos = Array.isArray(texto) ? texto : [texto];
const ultimo = parrafos.length - 1;
---

<figure class:list={['cita', { 'cita--larga': parrafos.length > 1 }]}>
  <blockquote>
    {parrafos.map((parrafo, i) => <p>{i === 0 && '«'}{parrafo}{i === ultimo && '»'}</p>)}
  </blockquote>
  <figcaption>{autoria}</figcaption>
</figure>

<style>
  .cita {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin: 0;
    padding: clamp(28px, 4vw, 40px);
    background: var(--color-papel);
    border-left: 4px solid var(--color-marca);
    border-radius: var(--radio-tarjeta);
  }

  .cita blockquote {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin: 0;
  }

  .cita blockquote p {
    font-size: clamp(1.25rem, 1.05rem + 0.75vw, 1.625rem); /* 20 → 26 px */
    line-height: 1.45;
  }

  .cita--larga blockquote p {
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.1875rem); /* 17 → 19 px */
    line-height: 1.65;
    max-width: 46rem;
  }

  .cita figcaption {
    font-size: 1rem;
    color: var(--color-texto-3);
  }
</style>
