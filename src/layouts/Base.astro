---
// Layout común: <head> con SEO (title, description, canonical, Open Graph, datos estructurados),
// favicons, Literata alojada en la propia web (precargada), cabecera y pie.
import fuenteUrl from '../assets/fonts/literata-opsz.woff2?url';
import '../styles/global.css';
import Cabecera from '../components/Cabecera.astro';
import Pie from '../components/Pie.astro';
import Revela from '../components/Revela.astro';
import { sitio } from '../data/sitio';

interface Props {
  /** <title>: la línea «Título» de los textos */
  titulo: string;
  /** meta description: la línea «Descripción para buscadores» */
  descripcion?: string;
  /** Imagen para redes, ruta dentro de public/ (1200 × 630) */
  imagen?: string;
  noindex?: boolean;
  /** Datos estructurados (JSON-LD) de la página: la organización en la portada, el servicio en cada servicio */
  datos?: object[];
}

const { titulo, descripcion = sitio.descripcion, imagen = '/og.png', noindex = false, datos = [] } = Astro.props;
const canonica = new URL(Astro.url.pathname, Astro.site);
const urlImagen = new URL(imagen, Astro.site);

---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica} />
    {noindex && <meta name="robots" content="noindex" />}

    <link rel="preload" href={fuenteUrl} as="font" type="font/woff2" crossorigin />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#F7F8F6" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={sitio.nombre} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={urlImagen} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`Logotipo de ${sitio.nombre}`} />
    <meta property="og:image:type" content="image/png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titulo} />
    <meta name="twitter:description" content={descripcion} />
    <meta name="twitter:image" content={urlImagen} />
    <meta name="twitter:image:alt" content={`Logotipo de ${sitio.nombre}`} />

    {datos.map((dato) => <script type="application/ld+json" set:html={JSON.stringify(dato)} />)}
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <Cabecera />
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    <Pie />
    <Revela />
  </body>
</html>
