# entretecas.com — reglas de servidor (Apache/LiteSpeed en Raiola).
# deploy/preparar.sh lo copia a dist/.htaccess. En staging va precedido de deploy/htaccess-staging.
# URLs con barra final: cada página es una carpeta con index.html (/planes/ → planes/index.html).

Options -Indexes
DirectoryIndex index.html

# Páginas de error
ErrorDocument 404 /404.html
ErrorDocument 403 /404.html
ErrorDocument 410 /404.html

# Archivos internos que no se sirven (.htaccess, .htpasswd y el estado de sincronización del despliegue)
<FilesMatch "^(\.ht.*|\.ftp-deploy-sync-state\.json)$">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # URL antiguas de la web WordPress anterior (inventario del 2026-11-18, textos-web/redirecciones.csv).
  # Van las primeras, antes de la regla de https/sin www y de la de entretecas.es: cada una llega a la URL nueva
  # completa (https, sin www) en un solo salto, entre por http, por https, con www o sin él. Cada regla lleva su
  # condición de host para que no actúen en staging (que no debe saltar a producción).
  # Una URL antigua que no cambia (/, /contacto/, /aviso-legal/) no necesita regla: basta la de https y sin www.
  # Para añadir una: una línea con su RewriteCond y su RewriteRule, y la fila en el CSV.
  RewriteCond %{HTTP_HOST} ^(?:www\.)?entretecas\.com$ [NC]
  RewriteRule ^alojamiento-optimizado-para-pmb/?$ https://entretecas.com/planes/ [R=301,L,NE]
  # /servicios/ no existe en la web nueva: va a la sección de la portada. NE para que el # no se codifique.
  RewriteCond %{HTTP_HOST} ^(?:www\.)?entretecas\.com$ [NC]
  RewriteRule ^servicios/?$ https://entretecas.com/#servicios [R=301,L,NE]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?entretecas\.com$ [NC]
  RewriteRule ^servicios/migracion-de-registros-bibliograficos/?$ https://entretecas.com/servicios/migracion/ [R=301,L,NE]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?entretecas\.com$ [NC]
  RewriteRule ^politica-de-privacidad/?$ https://entretecas.com/privacidad/ [R=301,L,NE]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?entretecas\.com$ [NC]
  RewriteRule ^politica-de-cookies/?$ https://entretecas.com/cookies/ [R=301,L,NE]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?entretecas\.com$ [NC]
  RewriteRule ^(?:sitemap_index|wp-sitemap)\.xml$ https://entretecas.com/sitemap-index.xml [R=301,L,NE]

  # Restos de WordPress sin sustituto: 410 (Gone), con la página 404 de la web (ErrorDocument 410).
  # page-sitemap.xml, feeds, xmlrpc y acceso; y todo lo de /wp-content/, /wp-includes/ y /wp-admin/.
  RewriteCond %{HTTP_HOST} ^(?:www\.)?entretecas\.com$ [NC]
  RewriteRule ^(?:page-sitemap\.xml|xmlrpc\.php|wp-login\.php|feed/?|comments/feed/?|(?:wp-content|wp-includes|wp-admin)(?:/.*)?)$ - [G,L]

  # entretecas.es → entretecas.com, conservando la ruta. Solo actúa si entretecas.es apunta a este
  # alojamiento (alias o dominio aparcado); si no, la redirección se hace en el panel de su hosting.
  RewriteCond %{HTTP_HOST} ^(?:www\.)?entretecas\.es$ [NC]
  RewriteRule ^ https://entretecas.com%{REQUEST_URI} [R=301,L,NE]

  # https y sin www, en un solo salto. No actúa en la petición interna de una página de error (REDIRECT_STATUS
  # relleno): si no, el 410 de una URL entrada por http o con www se convertiría en un 301 hacia /404.html.
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L,NE]

  # /algo/index.html → /algo/ (la web enlaza siempre sin index.html)
  RewriteCond %{THE_REQUEST} \s/+((?:[^?\s]*/)?)index\.html[?\s] [NC]
  RewriteRule ^ /%1 [R=301,L,NE]
</IfModule>

<IfModule mod_headers.c>
  # Cabeceras de seguridad
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  # HSTS de un año, sin includeSubDomains ni preload (mismo criterio que Esquí & Friends)
  Header always set Strict-Transport-Security "max-age=31536000"
  # CSP: todo propio. Scripts: solo ficheros de la web y el script en línea de la clase .js, por su hash
  # (deploy/preparar.sh sustituye __HASH_SCRIPT_JS__ por el hash real leído de dist/). Estilos: 'unsafe-inline'
  # porque el CSS va en línea (sin hojas que bloqueen la pintura) y hay atributos style (--min de las rejillas).
  # form-action 'self': el formulario solo puede enviarse a esta web (/api/contacto.php).
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-__HASH_SCRIPT_JS__'; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self'; connect-src 'self'; manifest-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"

  # Caché. HTML corto (5 min, luego se revalida); XML, robots y manifiesto, 1 hora; imágenes e iconos sin hash
  # (favicon, og.png, iconos), 1 semana. Lo de _astro/ (con hash en el nombre) va con un año y «immutable»
  # en su propio .htaccess (deploy/htaccess-assets).
  <FilesMatch "\.(html)$">
    Header set Cache-Control "public, max-age=300, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(xml|txt|webmanifest)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
  <FilesMatch "\.(png|ico|svg|jpg|jpeg|webp|avif|woff2)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

# Compresión: Brotli si el servidor lo tiene, y gzip (deflate) como respaldo. Las fuentes woff2 y las imágenes
# raster ya van comprimidas.
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/xml text/javascript application/javascript application/json application/ld+json application/xml application/manifest+json image/svg+xml image/x-icon
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml text/javascript application/javascript application/json application/ld+json application/xml application/manifest+json image/svg+xml image/x-icon
</IfModule>

AddType application/manifest+json .webmanifest
