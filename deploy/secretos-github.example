# Secretos del repositorio factoriathekes/entretecas-web
# (GitHub → Settings → Secrets and variables → Actions → New repository secret).
# Este archivo es solo la lista de nombres: NO poner valores aquí. Los valores los introduce Rai,
# en el panel de GitHub o con `gh secret set NOMBRE -R factoriathekes/entretecas-web` (pide el valor oculto).
# Cada entorno con su propia cuenta FTP de Raiola, limitada a su carpeta.

# Una sola cuenta FTP de Raiola; la carpeta de cada entorno va en su propio secreto.
FTP_SERVER=
FTP_USERNAME=
FTP_PASSWORD=
FTP_DIR_STAGING=                # carpeta de staging vista por esa cuenta FTP, terminada en /
FTP_DIR_PRODUCCION=             # solo cuando se active el job de producción (hoy desactivado), terminada en /

# Contraseña de acceso a staging (OPCIONAL: sin estos tres, staging solo lleva noindex y robots.txt)
STAGING_AUTH_USER=
STAGING_AUTH_PASSWORD=          # cualquier carácter, sin saltos de línea
STAGING_HTPASSWD_PATH=          # ruta ABSOLUTA en el servidor del .htpasswd, en la raíz de la carpeta de staging
